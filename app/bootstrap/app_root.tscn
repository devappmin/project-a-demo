[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://app/bootstrap/app_root.gd" id="1_app_root"]
[ext_resource type="PackedScene" path="res://content/maps/foundation_room.tscn" id="2_room"]
[ext_resource type="PackedScene" path="res://ui/hud/interaction_prompt.tscn" id="3_prompt"]

[node name="AppRoot" type="Node"]
script = ExtResource("1_app_root")

[node name="WorldHost" type="Node2D" parent="."]

[node name="FoundationRoom" parent="WorldHost" instance=ExtResource("2_room")]

[node name="ServiceLayer" type="Node" parent="."]

[node name="UILayer" type="CanvasLayer" parent="."]

[node name="InteractionPrompt" parent="UILayer" instance=ExtResource("3_prompt")]
detector_path = NodePath("../../WorldHost/FoundationRoom/Player/InteractionDetector")
